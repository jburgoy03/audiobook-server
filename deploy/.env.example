# Copy to /opt/docker/audiobook/.env on the server. Never commit the real one.

# Same password as the audiobook-db container's .env.
POSTGRES_PASSWORD=

# The server's Tailscale IP. The API listens on <this>:<HOST_PORT> only.
BIND_ADDRESS=100.83.139.4
HOST_PORT=5043

# The compose network audiobook-db is attached to (docker network ls).
DB_NETWORK=audiobook_default

# The network the portfolio stack's cloudflared container is on.
TUNNEL_NETWORK=portfolio_portfolio-net

# First start only: creates the account if none exists. At least 12 characters.
# Safe to remove once the account exists.
SEED_USERNAME=
SEED_PASSWORD=
